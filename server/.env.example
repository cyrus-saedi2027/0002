# نمونه‌ی تنظیمات سرور نوبت ساسان کلینیک
# این فایل را به نام server/.env کپی کنید و مقدارها را همان‌جا بنویسید.
# server/.env در .gitignore است و هرگز نباید وارد مخزن یا جای عمومی شود.

# ---------- سامانه‌ی پیامک sms.ir ----------
# sandbox = آزمایشی (پیامک واقعی فرستاده نمی‌شود و کد در لاگ سرور می‌آید)
# live    = اصلی (پیامک واقعی و کسر اعتبار)
SMSIR_MODE=sandbox

# کلید آزمایشی: پنل sms.ir ← برنامه‌نویسان ← لیست کلیدهای API ← ایجاد کلید (نوع Sandbox)
SMSIR_SANDBOX_KEY=

# کلید اصلی (فقط برای SMSIR_MODE=live). بهتر است در پنل به آی‌پی سرور محدود شود.
SMSIR_API_KEY=

# شناسه‌ی قالب کد تأیید در پنل (ارسال سریع). متن پیشنهادی:
#   ساسان کلینیک
#   کد تأیید نوبت شما: #CODE#
#   این کد را به کسی ندهید.
SMSIR_TEMPLATE_ID=
SMSIR_TEMPLATE_PARAM=CODE
# (npm run setup این قالب را خودش در پنل ثبت می‌کند و شناسه‌اش را این‌جا می‌گذارد)

# (اختیاری) پیامک ثبت درخواست به بیمار؛ پارامترها: DEPT, REF
#   درخواست نوبت #DEPT# شما ثبت شد. پذیرش ظرف ۳۰ دقیقه تا ۴ ساعت با شما تماس می‌گیرد. کد پیگیری: #REF# — ساسان کلینیک
SMSIR_CONFIRM_TEMPLATE_ID=

# (اختیاری) خبر درخواست تازه به موبایل پذیرش؛ پارامترها: NAME, DEPT, MOBILE
SMSIR_RECEPTION_TEMPLATE_ID=
RECEPTION_MOBILE=

# (اختیاری) پنل پذیرش — قالب نوع ۲ (اطلاع‌رسانی)؛ پارامترها: NAME, DEPT, DATE, TIME
#   تأیید نوبت:  #NAME# عزیز، نوبت #DEPT# شما در ساسان کلینیک برای #DATE# ساعت #TIME# ثبت شد.
#   یادآوری:    یادآوری: #NAME# عزیز، فردا #DATE# ساعت #TIME# نوبت #DEPT# در ساسان کلینیک دارید.
# (npm run setup در حالت اصلی هر دو را در پنل sms.ir ثبت می‌کند)
SMSIR_APPT_TEMPLATE_ID=
SMSIR_REMIND_TEMPLATE_ID=
# ساعت شروع ارسال یادآوری‌های فردا به وقت تهران (۸ تا ۲۱)
SMSIR_REMIND_HOUR=17

# ---------- امنیت ----------
# رشته‌ی تصادفی دست‌کم ۳۲ نویسه برای هش کدها (مثلاً خروجی: openssl rand -hex 32)
OTP_SECRET=

# توکن API قدیمی مدیریت (GET /api/bookings با Authorization: Bearer). پنل پذیرش به آن نیازی ندارد؛ خالی = خاموش
ADMIN_TOKEN=

# کد پیامکی ورود پنل پذیرش (۱ = روشن). فقط برای آزمایش روی کامپیوتر خودتان 0 بگذارید
PANEL_2FA=1

# ---------- اجرا ----------
PORT=8080
HOST=127.0.0.1
# پشت Nginx یا Cloudflare: 1 تا آی‌پی واقعی از X-Forwarded-For خوانده شود
TRUST_PROXY=0
# روی HTTPS: 1 تا سربرگ HSTS فرستاده شود
HSTS=0
# اگر سایت روی دامنه‌ی دیگری است و فقط API از این سرور می‌آید
ALLOWED_ORIGIN=
